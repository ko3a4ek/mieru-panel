# Mieru Panel - Environment Configuration

# Flask Secret Key (CHANGE THIS IN PRODUCTION!)
SECRET_KEY=your-secret-key-here-change-in-production

# Panel Configuration
PANEL_HOST=0.0.0.0
PANEL_PORT=5000

# Database Path
DB_PATH=data/mieru_panel.db

# Mita Configuration
MITA_CONFIG_PATH=/etc/mita/server.conf.json

# Logging
LOG_LEVEL=INFO
