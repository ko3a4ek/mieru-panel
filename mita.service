[Unit]
Description=Mieru Proxy Server
After=network.target

[Service]
Type=simple
User=root
ExecStart=/usr/bin/mita start
ExecStop=/usr/bin/mita stop
Restart=always
RestartSec=10
StandardOutput=journal
StandardError=journal

# Security settings
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
